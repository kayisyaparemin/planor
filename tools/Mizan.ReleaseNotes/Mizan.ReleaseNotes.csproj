<Project Sdk="Microsoft.NET.Sdk">

  <!--
    K4: sürüm notu okuyucusu (S82). Eskide not release.yml içinde `echo` zinciriyle üretiliyordu ve
    hiçbir sürüme bağlı değildi. Kural burada tek yerde durur; Mizan.Regression.Tests negatif durumlarla
    sınar, release.yml scripts/release-notes.ps1 üzerinden bu aracı çağırır.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
