<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:comp="clr-namespace:Mizan.App.Components"
             xmlns:icons="clr-namespace:Mizan.App.Icons"
             xmlns:strings="clr-namespace:Mizan.App.Resources"
             xmlns:auto="clr-namespace:Mizan.Presentation.Automation;assembly=Mizan.Presentation"
             xmlns:vm="clr-namespace:Mizan.Presentation.ViewModels;assembly=Mizan.Presentation"
             x:Class="Mizan.App.Pages.SimulationConditionPage"
             x:DataType="vm:SimulationConditionViewModel"
             AutomationId="{x:Static auto:SimulatorAutomationIds.PageSimulationCondition}">

    <!-- EK-V10: Deneme formu (V10a — nakit ödeme). Geri oku da Vazgeç'ten geçer: değişiklik varsa onay -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior Command="{Binding CancelCommand}" />
    </Shell.BackButtonBehavior>

    <ScrollView>
        <VerticalStackLayout Spacing="{StaticResource Space4}"
                             Padding="{StaticResource PagePadding}">

            <!-- S3: başlık denemenin türü; tür düzenlemede değişmez (S76-7) -->
            <comp:PageHeader Title="{Binding ScenarioType, Converter={StaticResource DenemeBasligi}}" />

            <!-- Yükleniyor (yalnız düzenlemede) -->
            <VerticalStackLayout Spacing="{StaticResource Space3}"
                                 IsVisible="{Binding IsLoading}">
                <comp:SkeletonBlock HeightRequest="{StaticResource Space6}" />
                <comp:SkeletonBlock HeightRequest="{StaticResource Space6}" />
            </VerticalStackLayout>

            <!-- Dolu: deneme alanları + kaydet / vazgeç -->
            <VerticalStackLayout Spacing="{StaticResource Space4}"
                                 IsVisible="{Binding IsContent}">

                <!-- S3: form kartı; ad zorunlu (S76-8), tarih en erken bugün (S76-3) -->
                <Border>
                    <VerticalStackLayout Spacing="{StaticResource Space3}">

                        <!-- S3: hedef kart (kartla harcama veya kart ödeme şekli; salt okunur, düzenlemede değişmez) -->
                        <VerticalStackLayout Spacing="{StaticResource Space1}"
                                             IsVisible="{Binding IsCard}">
                            <Label Text="{x:Static strings:SimulatorStrings.Etiket_Kart}"
                                   Style="{StaticResource Eyebrow}" />
                            <Label Text="{Binding CardName}"
                                   FontSize="{StaticResource TypeFigure}"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{DynamicResource TextPrimary}"
                                   AutomationId="{x:Static auto:SimulatorAutomationIds.LblConditionCard}" />
                        </VerticalStackLayout>

                        <!-- S3: hedef kredi (krediye erken ödeme; salt okunur, düzenlemede değişmez) -->
                        <VerticalStackLayout Spacing="{StaticResource Space1}"
                                             IsVisible="{Binding IsLoan}">
                            <Label Text="{x:Static strings:SimulatorStrings.Etiket_Kredi}"
                                   Style="{StaticResource Eyebrow}" />
                            <Label Text="{Binding LoanName}"
                                   FontSize="{StaticResource TypeFigure}"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{DynamicResource TextPrimary}"
                                   AutomationId="{x:Static auto:SimulatorAutomationIds.LblConditionLoan}" />
                        </VerticalStackLayout>

                        <!-- S3: kart ödeme şekli ve kapsamı (yalnız kart ödeme şeklinde) -->
                        <Grid ColumnDefinitions="*, *"
                              ColumnSpacing="{StaticResource Space2}"
                              IsVisible="{Binding IsCardPaymentMode}">
                            <VerticalStackLayout Spacing="{StaticResource Space1}">
                                <Label Text="{x:Static strings:SimulatorStrings.Etiket_OdemeSekli}"
                                       Style="{StaticResource Eyebrow}" />
                                <Picker ItemsSource="{Binding CardPaymentModes, Converter={StaticResource KartOdemeSecenegi}}"
                                        SelectedItem="{Binding SelectedCardPaymentMode, Converter={StaticResource KartOdemeSecenegi}}"
                                        BackgroundColor="{DynamicResource SurfaceSunken}"
                                        TextColor="{DynamicResource TextPrimary}"
                                        FontSize="{StaticResource TypeBody}"
                                        AutomationId="{x:Static auto:SimulatorAutomationIds.PickerConditionPaymentMode}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="{StaticResource Space1}">
                                <Label Text="{x:Static strings:SimulatorStrings.Etiket_Kapsam}"
                                       Style="{StaticResource Eyebrow}" />
                                <Picker ItemsSource="{Binding CardPaymentScopes, Converter={StaticResource KartOdemeSecenegi}, ConverterParameter=Kapsam}"
                                        SelectedItem="{Binding SelectedCardPaymentScope, Converter={StaticResource KartOdemeSecenegi}, ConverterParameter=Kapsam}"
                                        BackgroundColor="{DynamicResource SurfaceSunken}"
                                        TextColor="{DynamicResource TextPrimary}"
                                        FontSize="{StaticResource TypeBody}"
                                        AutomationId="{x:Static auto:SimulatorAutomationIds.PickerConditionPaymentScope}" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- S3: erken ödeme şekli (yalnız krediye erken ödemede) -->
                        <VerticalStackLayout Spacing="{StaticResource Space1}"
                                             IsVisible="{Binding IsLoanPrepayment}">
                            <Label Text="{x:Static strings:SimulatorStrings.Etiket_OdemeSekli}"
                                   Style="{StaticResource Eyebrow}" />
                            <Picker ItemsSource="{Binding PrepaymentModes, Converter={StaticResource ErkenOdemeTuru}}"
                                    SelectedItem="{Binding SelectedPrepaymentMode, Converter={StaticResource ErkenOdemeTuru}}"
                                    BackgroundColor="{DynamicResource SurfaceSunken}"
                                    TextColor="{DynamicResource TextPrimary}"
                                    FontSize="{StaticResource TypeBody}"
                                    AutomationId="{x:Static auto:SimulatorAutomationIds.PickerConditionPrepaymentMode}" />
                        </VerticalStackLayout>

                        <!-- S3: ad alanı -->
                        <VerticalStackLayout Spacing="{StaticResource Space1}">
                            <Label Text="{x:Static strings:SimulatorStrings.Etiket_Ad}"
                                   Style="{StaticResource Eyebrow}" />
                            <Entry Text="{Binding Name}"
                                   Placeholder="{x:Static strings:SimulatorStrings.YerTutucu_Ad}"
                                   AutomationId="{x:Static auto:SimulatorAutomationIds.InputConditionName}" />
                        </VerticalStackLayout>

                        <!-- S3: tutar ve tarih (tutar gerektiren türlerde) -->
                        <Grid ColumnDefinitions="*, *"
                              ColumnSpacing="{StaticResource Space2}"
                              IsVisible="{Binding NeedsAmount}">
                            <VerticalStackLayout Spacing="{StaticResource Space1}">
                                <Label Text="{x:Static strings:SimulatorStrings.Etiket_Tutar}"
                                       Style="{StaticResource Eyebrow}" />
                                <Entry Text="{Binding AmountInput}"
                                       Placeholder="{x:Static strings:SimulatorStrings.YerTutucu_Tutar}"
                                       Keyboard="Numeric"
                                       AutomationId="{x:Static auto:SimulatorAutomationIds.InputConditionAmount}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="{StaticResource Space1}">
                                <Label Text="{x:Static strings:SimulatorStrings.Etiket_Tarih}"
                                       Style="{StaticResource Eyebrow}" />
                                <DatePicker Date="{Binding Date, Converter={StaticResource TarihSecici}}"
                                            MinimumDate="{Binding MinimumDate, Converter={StaticResource TarihSecici}}"
                                            Format="dd.MM.yyyy"
                                            BackgroundColor="{DynamicResource SurfaceSunken}"
                                            TextColor="{DynamicResource TextPrimary}"
                                            FontSize="{StaticResource TypeBody}"
                                            AutomationId="{x:Static auto:SimulatorAutomationIds.PickerConditionDate}" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- S3: kart ödeme şeklinde tarih ("Hangi ekstreden itibaren") -->
                        <VerticalStackLayout Spacing="{StaticResource Space1}"
                                             IsVisible="{Binding IsCardPaymentMode}">
                            <Label Text="{x:Static strings:SimulatorStrings.Etiket_HangiEkstredenItibaren}"
                                   Style="{StaticResource Eyebrow}" />
                            <DatePicker Date="{Binding Date, Converter={StaticResource TarihSecici}}"
                                        MinimumDate="{Binding MinimumDate, Converter={StaticResource TarihSecici}}"
                                        Format="dd.MM.yyyy"
                                        BackgroundColor="{DynamicResource SurfaceSunken}"
                                        TextColor="{DynamicResource TextPrimary}"
                                        FontSize="{StaticResource TypeBody}" />
                        </VerticalStackLayout>

                        <!-- S3: taksit / ödeme sayısı (kartla harcama, düzenli ödeme, kredi veya nakit borç) -->
                        <VerticalStackLayout Spacing="{StaticResource Space1}"
                                             IsVisible="{Binding NeedsPaymentCount}">
                            <Label Text="{x:Static strings:SimulatorStrings.Etiket_TaksitSayisi}"
                                   Style="{StaticResource Eyebrow}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsRecurring}" Value="True">
                                        <Setter Property="Text" Value="{x:Static strings:SimulatorStrings.Etiket_OdemeSayisi}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsCashDebt}" Value="True">
                                        <Setter Property="Text" Value="{x:Static strings:SimulatorStrings.Etiket_OdemeSayisi}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Entry Text="{Binding PaymentCountInput}"
                                   Keyboard="Numeric"
                                   Placeholder="{x:Static strings:SimulatorStrings.YerTutucu_OdemeSayisi}"
                                   AutomationId="{x:Static auto:SimulatorAutomationIds.InputConditionPaymentCount}">
                                <Entry.Triggers>
                                    <DataTrigger TargetType="Entry" Binding="{Binding IsCardSpending}" Value="True">
                                        <Setter Property="Placeholder" Value="{x:Static strings:SimulatorStrings.YerTutucu_TaksitSayisi}" />
                                    </DataTrigger>
                                </Entry.Triggers>
                            </Entry>
                        </VerticalStackLayout>

                        <!-- S3: toplam geri ödeme tutarı (yalnız kredi çekmede) -->
                        <VerticalStackLayout Spacing="{StaticResource Space1}"
                                             IsVisible="{Binding NeedsTotalRepayment}">
                            <Label Text="{x:Static strings:SimulatorStrings.Etiket_ToplamGeriOdeme}"
                                   Style="{StaticResource Eyebrow}" />
                            <Entry Text="{Binding TotalRepaymentAmountInput}"
                                   Placeholder="{x:Static strings:SimulatorStrings.YerTutucu_ToplamGeriOdeme}"
                                   Keyboard="Numeric"
                                   AutomationId="{x:Static auto:SimulatorAutomationIds.InputConditionTotalRepayment}" />
                        </VerticalStackLayout>

                        <!-- S3: ilk ödeme tarihi (yalnız kredi çekmede) -->
                        <VerticalStackLayout Spacing="{StaticResource Space1}"
                                             IsVisible="{Binding NeedsFirstPaymentDate}">
                            <Label Text="{x:Static strings:SimulatorStrings.Etiket_IlkOdemeTarihi}"
                                   Style="{StaticResource Eyebrow}" />
                            <DatePicker Date="{Binding FirstPaymentDate, Converter={StaticResource TarihSecici}}"
                                        MinimumDate="{Binding MinimumDate, Converter={StaticResource TarihSecici}}"
                                        Format="dd.MM.yyyy"
                                        BackgroundColor="{DynamicResource SurfaceSunken}"
                                        TextColor="{DynamicResource TextPrimary}"
                                        FontSize="{StaticResource TypeBody}"
                                        AutomationId="{x:Static auto:SimulatorAutomationIds.PickerConditionFirstPaymentDate}" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- S3: kaydet listeye yazar ve simülatöre döner; vazgeç değişiklik varsa onay sorar -->
                <Grid ColumnDefinitions="*, *"
                      ColumnSpacing="{StaticResource Space2}">
                    <Button Text="{x:Static strings:SimulatorStrings.Aksiyon_Kaydet}"
                            Command="{Binding SaveCommand}"
                            AutomationId="{x:Static auto:SimulatorAutomationIds.BtnSaveCondition}" />
                    <Button Grid.Column="1"
                            Text="{x:Static strings:SimulatorStrings.Aksiyon_Vazgec}"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding CancelCommand}"
                            AutomationId="{x:Static auto:SimulatorAutomationIds.BtnCancelCondition}" />
                </Grid>
            </VerticalStackLayout>

            <!-- Hata: düzenlenecek deneme okunamadı -->
            <comp:StateBlock CurrentState="Error"
                             IconGlyph="{x:Static icons:Icons.Close}"
                             Message="{x:Static strings:SimulatorStrings.Hata_DenemeYuklenemedi}"
                             ActionText="{x:Static strings:Strings.Aksiyon_TekrarDene}"
                             ActionCommand="{Binding LoadCommand}"
                             IsVisible="{Binding IsError}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
