<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:comp="clr-namespace:Mizan.App.Components"
             xmlns:icons="clr-namespace:Mizan.App.Icons"
             xmlns:strings="clr-namespace:Mizan.App.Resources"
             xmlns:auto="clr-namespace:Mizan.Presentation.Automation;assembly=Mizan.Presentation"
             xmlns:models="clr-namespace:Mizan.Presentation.Models;assembly=Mizan.Presentation"
             xmlns:vm="clr-namespace:Mizan.Presentation.ViewModels;assembly=Mizan.Presentation"
             x:Class="Mizan.App.Pages.IncomeFormPage"
             x:DataType="vm:IncomeFormViewModel"
             AutomationId="{x:Static auto:RecordFormAutomationIds.PageIncomeForm}">

    <!-- EK-V6d: Düzenli gelir formu (V6d1 tanım, V6d2 tutar değişiklikleri). Geri oku da Vazgeç'ten geçer: değişiklik varsa onay -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior Command="{Binding CancelCommand}" />
    </Shell.BackButtonBehavior>

    <ContentPage.Resources>
        <!-- Tutar satırı: tarih itibarıyla · tutar; dokununca silme veya bilgi sorulur (S67-5) -->
        <DataTemplate x:Key="TutarSatiri"
                      x:DataType="models:IncomeAmountRow">
            <Grid ColumnDefinitions="*, Auto"
                  ColumnSpacing="{StaticResource Space3}">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:IncomeFormViewModel}}, Path=Amounts.SelectCommand}"
                                          CommandParameter="{Binding .}" />
                </Grid.GestureRecognizers>
                <Label Text="{Binding EffectiveDate, Converter={StaticResource Tarih}, ConverterParameter='d MMMM yyyy', StringFormat={x:Static strings:IncomeFormStrings.Bicim_Itibariyla}}"
                       FontSize="{StaticResource TypeBody}"
                       TextColor="{DynamicResource TextSecondary}"
                       VerticalTextAlignment="Center" />
                <Label Grid.Column="1"
                       Text="{Binding Amount, Converter={StaticResource Para}}"
                       Style="{StaticResource Figure}"
                       VerticalTextAlignment="Center" />
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="{StaticResource Space4}"
                             Padding="{StaticResource PagePadding}">

            <!-- S1: yeni gelir ya da düzenleme -->
            <comp:PageHeader Title="{x:Static strings:IncomeFormStrings.Baslik_YeniGelir}">
                <comp:PageHeader.Triggers>
                    <DataTrigger TargetType="comp:PageHeader" Binding="{Binding IsEditing}" Value="True">
                        <Setter Property="Title" Value="{x:Static strings:IncomeFormStrings.Baslik_GeliriDuzenle}" />
                    </DataTrigger>
                </comp:PageHeader.Triggers>
            </comp:PageHeader>

            <!-- Yükleniyor (yalnız düzenlemede) -->
            <VerticalStackLayout Spacing="{StaticResource Space3}"
                                 IsVisible="{Binding IsLoading}">
                <comp:SkeletonBlock HeightRequest="{StaticResource Space6}" />
                <comp:SkeletonBlock HeightRequest="{StaticResource Space6}" />
                <comp:SkeletonBlock HeightRequest="{StaticResource Space6}" />
            </VerticalStackLayout>

            <!-- Dolu: gelirin tanımı + kaydet / vazgeç -->
            <VerticalStackLayout Spacing="{StaticResource Space4}"
                                 IsVisible="{Binding IsContent}">

                <!-- S1: form kartı; alanlar kurulumun gelir adımıyla aynı sırada ve adla (S67-2) -->
                <Border>
                    <VerticalStackLayout Spacing="{StaticResource Space3}">
                        <VerticalStackLayout Spacing="{StaticResource Space1}">
                            <Label Text="{x:Static strings:IncomeFormStrings.Etiket_GelirAdi}"
                                   Style="{StaticResource Eyebrow}" />
                            <Entry Text="{Binding Fields.Name}"
                                   Placeholder="{x:Static strings:IncomeFormStrings.YerTutucu_GelirAdi}"
                                   AutomationId="{x:Static auto:RecordFormAutomationIds.InputIncomeName}" />
                        </VerticalStackLayout>
                        <!-- Yalnız yeni gelirde: ilk tutar bugünden yürürlüğe girer; kayıtlı gelirin tutarı geçmiştir -->
                        <VerticalStackLayout Spacing="{StaticResource Space1}"
                                             IsVisible="{Binding Fields.ShowsAmount}">
                            <Label Text="{x:Static strings:IncomeFormStrings.Etiket_AylikNetTutar}"
                                   Style="{StaticResource Eyebrow}" />
                            <Entry Text="{Binding Fields.AmountInput}"
                                   Placeholder="{x:Static strings:IncomeFormStrings.YerTutucu_Tutar}"
                                   Keyboard="Numeric"
                                   AutomationId="{x:Static auto:RecordFormAutomationIds.InputIncomeAmount}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="{StaticResource Space1}">
                            <Label Text="{x:Static strings:IncomeFormStrings.Etiket_OdemeGunu}"
                                   Style="{StaticResource Eyebrow}" />
                            <Entry Text="{Binding Fields.PaymentDayInput}"
                                   Placeholder="{x:Static strings:IncomeFormStrings.YerTutucu_Gun}"
                                   Keyboard="Numeric"
                                   AutomationId="{x:Static auto:RecordFormAutomationIds.InputIncomePaymentDay}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- S2: tutar değişiklikleri; ≤ 4 satır, fazlası yerinde açılır (GS21); yalnız düzenlemede -->
                <comp:ListCard EyebrowText="{x:Static strings:IncomeFormStrings.Etiket_AylikNetTutar}"
                               ItemsSource="{Binding Amounts.Items}"
                               ItemTemplate="{StaticResource TutarSatiri}"
                               OverflowText="{Binding Amounts.HiddenCount, Converter={StaticResource FazlaKayit}}"
                               OverflowCommand="{Binding Amounts.ExpandCommand}"
                               IsVisible="{Binding Amounts.HasItems}"
                               AutomationId="{x:Static auto:RecordFormAutomationIds.ListIncomeAmounts}" />

                <!-- S3: giriş kapalıyken aksiyon görünür; yalnız düzenlemede -->
                <Button Text="{x:Static strings:IncomeFormStrings.Aksiyon_TutarDegisikligiEkle}"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding Amounts.OpenEntryCommand}"
                        AutomationId="{x:Static auto:RecordFormAutomationIds.BtnOpenIncomeAmount}"
                        IsVisible="{Binding IsEditing}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding Amounts.IsEntryOpen}" Value="True">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <!-- S3: tutar girişi; yeni tutar ve bugünden sonraki geçerlilik tarihi (S67-5) -->
                <Border IsVisible="{Binding Amounts.IsEntryOpen}">
                    <VerticalStackLayout Spacing="{StaticResource Space3}">
                        <Grid ColumnDefinitions="*, *"
                              ColumnSpacing="{StaticResource Space2}">
                            <VerticalStackLayout Spacing="{StaticResource Space1}">
                                <Label Text="{x:Static strings:IncomeFormStrings.Etiket_YeniTutar}"
                                       Style="{StaticResource Eyebrow}" />
                                <Entry Text="{Binding Amounts.AmountInput}"
                                       Placeholder="{x:Static strings:IncomeFormStrings.YerTutucu_Tutar}"
                                       Keyboard="Numeric"
                                       AutomationId="{x:Static auto:RecordFormAutomationIds.InputIncomeNewAmount}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="{StaticResource Space1}">
                                <Label Text="{x:Static strings:IncomeFormStrings.Etiket_GecerlilikTarihi}"
                                       Style="{StaticResource Eyebrow}" />
                                <DatePicker Date="{Binding Amounts.EntryDate, Converter={StaticResource TarihSecici}}"
                                            MinimumDate="{Binding Amounts.MinimumDate, Converter={StaticResource TarihSecici}}"
                                            Format="dd.MM.yyyy"
                                            BackgroundColor="{DynamicResource SurfaceSunken}"
                                            TextColor="{DynamicResource TextPrimary}"
                                            FontSize="{StaticResource TypeBody}"
                                            AutomationId="{x:Static auto:RecordFormAutomationIds.PickerIncomeEffectiveDate}" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*, *"
                              ColumnSpacing="{StaticResource Space2}">
                            <Button Text="{x:Static strings:IncomeFormStrings.Aksiyon_Ekle}"
                                    Command="{Binding Amounts.AddCommand}"
                                    AutomationId="{x:Static auto:RecordFormAutomationIds.BtnAddIncomeAmount}" />
                            <Button Grid.Column="1"
                                    Text="{x:Static strings:IncomeFormStrings.Aksiyon_Vazgec}"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding Amounts.CancelEntryCommand}"
                                    AutomationId="{x:Static auto:RecordFormAutomationIds.BtnCancelIncomeAmount}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- S1: kaydet geliri ve ilk tutarını tek işlemde yazıp listeye döner; vazgeç değişiklik varsa onay sorar -->
                <Grid ColumnDefinitions="*, *"
                      ColumnSpacing="{StaticResource Space2}">
                    <Button Text="{x:Static strings:IncomeFormStrings.Aksiyon_Kaydet}"
                            Command="{Binding SaveCommand}"
                            AutomationId="{x:Static auto:RecordFormAutomationIds.BtnSaveIncome}" />
                    <Button Grid.Column="1"
                            Text="{x:Static strings:IncomeFormStrings.Aksiyon_Vazgec}"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding CancelCommand}"
                            AutomationId="{x:Static auto:RecordFormAutomationIds.BtnCancelIncome}" />
                </Grid>
            </VerticalStackLayout>

            <!-- Hata: düzenlenecek gelir okunamadı -->
            <comp:StateBlock CurrentState="Error"
                             IconGlyph="{x:Static icons:Icons.Close}"
                             Message="{x:Static strings:IncomeFormStrings.Hata_GelirYuklenemedi}"
                             ActionText="{x:Static strings:Strings.Aksiyon_TekrarDene}"
                             ActionCommand="{Binding RetryCommand}"
                             IsVisible="{Binding IsError}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
