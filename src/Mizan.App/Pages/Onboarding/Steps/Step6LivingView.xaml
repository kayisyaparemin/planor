<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:Mizan.App.Resources"
             xmlns:vm="clr-namespace:Mizan.Presentation.ViewModels;assembly=Mizan.Presentation"
             x:Class="Mizan.App.Pages.Onboarding.Steps.Step6LivingView"
             x:DataType="vm:OnboardingViewModel">

    <Border>
        <VerticalStackLayout Spacing="{StaticResource Space3}">
            <Label Text="{x:Static res:OnboardingStrings.Etiket_YasamGideri}"
                   Style="{StaticResource Eyebrow}" />
            <Entry Text="{Binding VariableExpenseAllowance}"
                   Keyboard="Numeric"
                   Placeholder="Örn. 15000" />
            <Label Text="Faturalar ve borçlar dışındaki serbest harçlık, yeme-içme ve market havuzun."
                   Style="{StaticResource Caption}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
