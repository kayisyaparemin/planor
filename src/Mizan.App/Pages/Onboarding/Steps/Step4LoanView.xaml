<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:Mizan.App.Resources"
             xmlns:auto="clr-namespace:Mizan.Presentation.Automation;assembly=Mizan.Presentation"
             xmlns:onb="clr-namespace:Mizan.Presentation.Onboarding.Models;assembly=Mizan.Presentation"
             xmlns:vm="clr-namespace:Mizan.Presentation.ViewModels;assembly=Mizan.Presentation"
             x:Class="Mizan.App.Pages.Onboarding.Steps.Step4LoanView"
             x:DataType="vm:OnboardingViewModel">

    <Border>
        <VerticalStackLayout Spacing="{StaticResource Space3}">
            <VerticalStackLayout Spacing="{StaticResource Space1}">
                <Label Text="{x:Static res:OnboardingStrings.Etiket_KrediAdi}"
                       Style="{StaticResource Eyebrow}" />
                <Entry Text="{Binding LoanName}"
                       Placeholder="Örn. Konut Kredisi, İhtiyaç" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="{StaticResource Space1}">
                <Label Text="{x:Static res:OnboardingStrings.Etiket_Banka}"
                       Style="{StaticResource Eyebrow}" />
                <Entry Text="{Binding LoanBank}"
                       Placeholder="Örn. Ziraat Bankası" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="{StaticResource Space1}">
                <Label Text="{x:Static res:OnboardingStrings.Etiket_AylikTaksit}"
                       Style="{StaticResource Eyebrow}" />
                <Entry Text="{Binding LoanMonthlyPayment}"
                       Keyboard="Numeric"
                       Placeholder="Örn. 12500" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="{StaticResource Space2}">
                <VerticalStackLayout Grid.Column="0"
                                     Spacing="{StaticResource Space1}">
                    <Label Text="{x:Static res:OnboardingStrings.Etiket_TaksitGunu}"
                           Style="{StaticResource Eyebrow}" />
                    <Entry Text="{Binding LoanPaymentDay}"
                           Keyboard="Numeric"
                           Placeholder="15" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1"
                                     Spacing="{StaticResource Space1}">
                    <Label Text="{x:Static res:OnboardingStrings.Etiket_KalanTaksitSayisi}"
                           Style="{StaticResource Eyebrow}" />
                    <Entry Text="{Binding LoanInstallments}"
                           Keyboard="Numeric"
                           Placeholder="Örn. 24" />
                </VerticalStackLayout>
            </Grid>

            <Button Text="{x:Static res:OnboardingStrings.Aksiyon_KrediEkle}"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding AddLoanCommand}"
                    AutomationId="{x:Static auto:AutomationIds.BtnOnboardingAddLoan}" />

            <!-- Eklenen Krediler Listesi -->
            <VerticalStackLayout Spacing="{StaticResource Space2}"
                                 BindableLayout.ItemsSource="{Binding DraftLoans}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="onb:OnboardingDraftItem">
                        <Border BackgroundColor="{DynamicResource SurfaceSunken}"
                                Padding="{StaticResource Space2}">
                            <Grid ColumnDefinitions="*,Auto,Auto"
                                  ColumnSpacing="{StaticResource Space2}">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="{Binding Title}"
                                           Style="{StaticResource SectionTitle}" />
                                    <Label Text="{Binding Subtitle}"
                                           Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Text="{Binding Amount, Converter={StaticResource Para}}"
                                       Style="{StaticResource Figure}"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="2"
                                        Text="{x:Static res:OnboardingStrings.Aksiyon_Sil}"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:OnboardingViewModel}}, Path=RemoveLoanCommand}"
                                        CommandParameter="{Binding .}"
                                        VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
