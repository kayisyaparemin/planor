<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:Mizan.App.Resources"
             xmlns:auto="clr-namespace:Mizan.Presentation.Automation;assembly=Mizan.Presentation"
             xmlns:onb="clr-namespace:Mizan.Presentation.Onboarding.Models;assembly=Mizan.Presentation"
             xmlns:vm="clr-namespace:Mizan.Presentation.ViewModels;assembly=Mizan.Presentation"
             x:Class="Mizan.App.Pages.Onboarding.Steps.Step3CardView"
             x:DataType="vm:OnboardingViewModel">

    <Border>
        <VerticalStackLayout Spacing="{StaticResource Space3}">
            <VerticalStackLayout Spacing="{StaticResource Space1}">
                <Label Text="{x:Static res:OnboardingStrings.Etiket_KartAdi}"
                       Style="{StaticResource Eyebrow}" />
                <Entry Text="{Binding CardName}"
                       Placeholder="Örn. Bonus, Maximum" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="{StaticResource Space1}">
                <Label Text="{x:Static res:OnboardingStrings.Etiket_Banka}"
                       Style="{StaticResource Eyebrow}" />
                <Entry Text="{Binding CardBank}"
                       Placeholder="Örn. Garanti BBVA" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="{StaticResource Space2}">
                <VerticalStackLayout Grid.Column="0"
                                     Spacing="{StaticResource Space1}">
                    <Label Text="{x:Static res:OnboardingStrings.Etiket_Limit}"
                           Style="{StaticResource Eyebrow}" />
                    <Entry Text="{Binding CardLimit}"
                           Keyboard="Numeric"
                           Placeholder="Örn. 50000" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1"
                                     Spacing="{StaticResource Space1}">
                    <Label Text="{x:Static res:OnboardingStrings.Etiket_GuncelBorc}"
                           Style="{StaticResource Eyebrow}" />
                    <Entry Text="{Binding CardCurrentDebt}"
                           Keyboard="Numeric"
                           Placeholder="0" />
                </VerticalStackLayout>
            </Grid>

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="{StaticResource Space2}">
                <VerticalStackLayout Grid.Column="0"
                                     Spacing="{StaticResource Space1}">
                    <Label Text="{x:Static res:OnboardingStrings.Etiket_KesimGunu}"
                           Style="{StaticResource Eyebrow}" />
                    <Entry Text="{Binding CardClosingDay}"
                           Keyboard="Numeric"
                           Placeholder="10" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1"
                                     Spacing="{StaticResource Space1}">
                    <Label Text="{x:Static res:OnboardingStrings.Etiket_SonOdemeGunu}"
                           Style="{StaticResource Eyebrow}" />
                    <Entry Text="{Binding CardDueDay}"
                           Keyboard="Numeric"
                           Placeholder="20" />
                </VerticalStackLayout>
            </Grid>

            <Button Text="{x:Static res:OnboardingStrings.Aksiyon_KartEkle}"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding AddCardCommand}"
                    AutomationId="{x:Static auto:AutomationIds.BtnOnboardingAddCard}" />

            <!-- Eklenen Kartlar Listesi -->
            <VerticalStackLayout Spacing="{StaticResource Space2}"
                                 BindableLayout.ItemsSource="{Binding DraftCards}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="onb:OnboardingDraftItem">
                        <Border BackgroundColor="{DynamicResource SurfaceSunken}"
                                Padding="{StaticResource Space2}">
                            <Grid ColumnDefinitions="*,Auto,Auto"
                                  ColumnSpacing="{StaticResource Space2}">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="{Binding Title}"
                                           Style="{StaticResource SectionTitle}" />
                                    <Label Text="{Binding Subtitle}"
                                           Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Text="{Binding Amount, Converter={StaticResource Para}}"
                                       Style="{StaticResource Figure}"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="2"
                                        Text="{x:Static res:OnboardingStrings.Aksiyon_Sil}"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:OnboardingViewModel}}, Path=RemoveCardCommand}"
                                        CommandParameter="{Binding .}"
                                        VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
