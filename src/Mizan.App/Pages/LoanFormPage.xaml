<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:comp="clr-namespace:Mizan.App.Components"
             xmlns:icons="clr-namespace:Mizan.App.Icons"
             xmlns:strings="clr-namespace:Mizan.App.Resources"
             xmlns:auto="clr-namespace:Mizan.Presentation.Automation;assembly=Mizan.Presentation"
             xmlns:models="clr-namespace:Mizan.Presentation.Models;assembly=Mizan.Presentation"
             xmlns:vm="clr-namespace:Mizan.Presentation.ViewModels;assembly=Mizan.Presentation"
             x:Class="Mizan.App.Pages.LoanFormPage"
             x:DataType="vm:LoanFormViewModel"
             AutomationId="{x:Static auto:RecordFormAutomationIds.PageLoanForm}">

    <!-- EK-V6c: Kredi formu (V6c1 kredinin tanımı, V6c2 faiz kartı, V6c3 erken ödemeler). Geri oku da Vazgeç'ten geçer: değişiklik varsa onay -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior Command="{Binding CancelCommand}" />
    </Shell.BackButtonBehavior>

    <ContentPage.Resources>
        <!-- Erken ödeme satırı: şekil · tarih · o gün ödenecek; dokununca silme sorulur (S64-6). Tarihte yıl var: plan bir yıldan uzak olabilir -->
        <DataTemplate x:Key="ErkenOdemeSatiri"
                      x:DataType="models:LoanPrepaymentRow">
            <Grid ColumnDefinitions="*, Auto"
                  ColumnSpacing="{StaticResource Space3}">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LoanFormViewModel}}, Path=Prepayments.SelectCommand}"
                                          CommandParameter="{Binding .}" />
                </Grid.GestureRecognizers>
                <VerticalStackLayout Spacing="{StaticResource Space1}"
                                     VerticalOptions="Center">
                    <Label Text="{Binding Mode, Converter={StaticResource ErkenOdemeTuru}}"
                           FontSize="{StaticResource TypeBody}"
                           TextColor="{DynamicResource TextPrimary}" />
                    <Label Text="{Binding Date, Converter={StaticResource Tarih}, ConverterParameter='d MMMM yyyy'}"
                           Style="{StaticResource Caption}" />
                </VerticalStackLayout>
                <!-- Hesaplanamıyorsa "—" (Para çeviricisi) -->
                <Label Grid.Column="1"
                       Text="{Binding Amount, Converter={StaticResource Para}}"
                       Style="{StaticResource Figure}"
                       VerticalTextAlignment="Center" />
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="{StaticResource Space4}"
                             Padding="{StaticResource PagePadding}">

            <!-- S1: yeni kredi ya da düzenleme -->
            <comp:PageHeader Title="{x:Static strings:LoanFormStrings.Baslik_YeniKredi}">
                <comp:PageHeader.Triggers>
                    <DataTrigger TargetType="comp:PageHeader" Binding="{Binding IsEditing}" Value="True">
                        <Setter Property="Title" Value="{x:Static strings:LoanFormStrings.Baslik_KrediyiDuzenle}" />
                    </DataTrigger>
                </comp:PageHeader.Triggers>
            </comp:PageHeader>

            <!-- Yükleniyor (yalnız düzenlemede) -->
            <VerticalStackLayout Spacing="{StaticResource Space3}"
                                 IsVisible="{Binding IsLoading}">
                <comp:SkeletonBlock HeightRequest="{StaticResource Space6}" />
                <comp:SkeletonBlock HeightRequest="{StaticResource Space6}" />
                <comp:SkeletonBlock HeightRequest="{StaticResource Space6}" />
            </VerticalStackLayout>

            <!-- Dolu: kredinin tanımı + faiz kartı + kaydet / vazgeç -->
            <VerticalStackLayout Spacing="{StaticResource Space4}"
                                 IsVisible="{Binding IsContent}">

                <!-- S1: form kartı; ödeme günü sonraki taksit tarihinden çözülür (S64-2) -->
                <Border>
                    <VerticalStackLayout Spacing="{StaticResource Space3}">
                        <VerticalStackLayout Spacing="{StaticResource Space1}">
                            <Label Text="{x:Static strings:LoanFormStrings.Etiket_KrediAdi}"
                                   Style="{StaticResource Eyebrow}" />
                            <Entry Text="{Binding Fields.Name}"
                                   Placeholder="{x:Static strings:LoanFormStrings.YerTutucu_KrediAdi}"
                                   AutomationId="{x:Static auto:RecordFormAutomationIds.InputLoanName}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="{StaticResource Space1}">
                            <Label Text="{x:Static strings:LoanFormStrings.Etiket_Banka}"
                                   Style="{StaticResource Eyebrow}" />
                            <Entry Text="{Binding Fields.Bank}"
                                   Placeholder="{x:Static strings:LoanFormStrings.YerTutucu_Banka}"
                                   AutomationId="{x:Static auto:RecordFormAutomationIds.InputLoanBank}" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*, *"
                              RowDefinitions="Auto, Auto"
                              ColumnSpacing="{StaticResource Space2}"
                              RowSpacing="{StaticResource Space1}">
                            <Label Text="{x:Static strings:LoanFormStrings.Etiket_AylikTaksit}"
                                   Style="{StaticResource Eyebrow}" />
                            <Label Grid.Column="1"
                                   Text="{x:Static strings:LoanFormStrings.Etiket_KalanTaksit}"
                                   Style="{StaticResource Eyebrow}" />
                            <Entry Grid.Row="1"
                                   Text="{Binding Fields.PaymentInput}"
                                   Placeholder="{x:Static strings:LoanFormStrings.YerTutucu_Tutar}"
                                   Keyboard="Numeric"
                                   AutomationId="{x:Static auto:RecordFormAutomationIds.InputLoanPayment}" />
                            <Entry Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding Fields.CountInput}"
                                   Placeholder="{x:Static strings:LoanFormStrings.YerTutucu_TaksitSayisi}"
                                   Keyboard="Numeric"
                                   AutomationId="{x:Static auto:RecordFormAutomationIds.InputLoanCount}" />
                        </Grid>

                        <Grid ColumnDefinitions="*, *"
                              RowDefinitions="Auto, Auto"
                              ColumnSpacing="{StaticResource Space2}"
                              RowSpacing="{StaticResource Space1}">
                            <Label Text="{x:Static strings:LoanFormStrings.Etiket_SonrakiTaksit}"
                                   Style="{StaticResource Eyebrow}" />
                            <Label Grid.Column="1"
                                   Text="{x:Static strings:LoanFormStrings.Etiket_KrediTuru}"
                                   Style="{StaticResource Eyebrow}" />
                            <!-- Geçmiş tarih serbest: dönem kapanışı tarihi ilerletir (S64-2) -->
                            <DatePicker Grid.Row="1"
                                        Date="{Binding Fields.NextPaymentDate, Converter={StaticResource TarihSecici}}"
                                        Format="dd.MM.yyyy"
                                        BackgroundColor="{DynamicResource SurfaceSunken}"
                                        TextColor="{DynamicResource TextPrimary}"
                                        FontSize="{StaticResource TypeBody}"
                                        AutomationId="{x:Static auto:RecordFormAutomationIds.PickerLoanNextDate}" />
                            <!-- Ham LoanKind; görünen ad ve geri çeviri KrediTuruConverter'da -->
                            <Picker Grid.Row="1"
                                    Grid.Column="1"
                                    ItemsSource="{Binding Fields.Kinds, Converter={StaticResource KrediTuru}}"
                                    SelectedItem="{Binding Fields.Kind, Converter={StaticResource KrediTuru}}"
                                    Title="{x:Static strings:LoanFormStrings.Etiket_KrediTuru}"
                                    BackgroundColor="{DynamicResource SurfaceSunken}"
                                    TextColor="{DynamicResource TextPrimary}"
                                    TitleColor="{DynamicResource TextSecondary}"
                                    FontSize="{StaticResource TypeBody}"
                                    AutomationId="{x:Static auto:RecordFormAutomationIds.PickerLoanKind}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- S2: faiz kartı; formun o anki değerlerinden kaydın kurallarıyla canlı çözülür (S64-9) -->
                <Border>
                    <VerticalStackLayout Spacing="{StaticResource Space3}">
                        <VerticalStackLayout Spacing="{StaticResource Space1}">
                            <Label Text="{x:Static strings:LoanFormStrings.Etiket_KalanAnapara}"
                                   Style="{StaticResource Eyebrow}" />
                            <Entry Text="{Binding Payoff.PrincipalInput}"
                                   Placeholder="{x:Static strings:LoanFormStrings.YerTutucu_IstegeBagli}"
                                   Keyboard="Numeric"
                                   AutomationId="{x:Static auto:RecordFormAutomationIds.InputLoanPrincipal}" />
                        </VerticalStackLayout>

                        <!-- İkisi birlikte girilirse kapatma tutarı otoritedir (I25) -->
                        <VerticalStackLayout Spacing="{StaticResource Space1}">
                            <Label Text="{x:Static strings:LoanFormStrings.Etiket_KapatmaTutari}"
                                   Style="{StaticResource Eyebrow}" />
                            <Entry Text="{Binding Payoff.ClosureInput}"
                                   Placeholder="{x:Static strings:LoanFormStrings.YerTutucu_IstegeBagli}"
                                   Keyboard="Numeric"
                                   AutomationId="{x:Static auto:RecordFormAutomationIds.InputLoanClosureAmount}" />
                        </VerticalStackLayout>

                        <!-- Hâl A: faiz çözüldü; satırlar önem sırasında, kapatılacak taksit yoksa yalnız aylık faiz (S64-11) -->
                        <VerticalStackLayout Spacing="{StaticResource Space2}"
                                             IsVisible="{Binding Payoff.IsResolved}">
                            <comp:MetricRow LabelText="{x:Static strings:LoanFormStrings.Etiket_BugunKapatirsan}"
                                            ValueText="{Binding Payoff.PayoffAmount, Converter={StaticResource Para}}"
                                            IsVisible="{Binding Payoff.HasPayoff}" />
                            <comp:MetricRow LabelText="{x:Static strings:LoanFormStrings.Etiket_ErkenOdemeUcreti}"
                                            ValueText="{Binding Payoff.Fee, Converter={StaticResource Para}}"
                                            IsVisible="{Binding Payoff.HasFee}" />
                            <comp:MetricRow LabelText="{x:Static strings:LoanFormStrings.Etiket_KurtulacaginFaiz}"
                                            ValueText="{Binding Payoff.InterestSaving, Converter={StaticResource Para}}"
                                            Semantic="Positive"
                                            IsVisible="{Binding Payoff.HasInterestSaving}" />
                            <comp:MetricRow LabelText="{x:Static strings:LoanFormStrings.Etiket_AylikFaiz}"
                                            ValueText="{Binding Payoff.MonthlyRate, Converter={StaticResource Yuzde}}" />
                        </VerticalStackLayout>

                        <!-- Hâl B: geçerli tutar yok · Hâl C: tutar kayıtta reddedilecek; aynı anda biri -->
                        <Label Text="{x:Static strings:LoanFormStrings.Cumle_FaizIcinTutarGir}"
                               Style="{StaticResource Caption}"
                               IsVisible="{Binding Payoff.NeedsAmount}" />
                        <Label Text="{x:Static strings:LoanFormStrings.Cumle_TutarUyusmuyor}"
                               Style="{StaticResource Caption}"
                               IsVisible="{Binding Payoff.IsMismatch}" />
                    </VerticalStackLayout>
                </Border>

                <!-- S3: planlı erken ödemeler (simülatörden uygulananlar dahil); ≤ 4 satır, fazlası yerinde açılır (GS21) -->
                <comp:ListCard EyebrowText="{x:Static strings:LoanFormStrings.Etiket_ErkenOdemeler}"
                               ItemsSource="{Binding Prepayments.Items}"
                               ItemTemplate="{StaticResource ErkenOdemeSatiri}"
                               OverflowText="{Binding Prepayments.HiddenCount, Converter={StaticResource FazlaKayit}}"
                               OverflowCommand="{Binding Prepayments.ExpandCommand}"
                               IsVisible="{Binding Prepayments.HasItems}"
                               AutomationId="{x:Static auto:RecordFormAutomationIds.ListLoanPrepayments}" />

                <!-- S4: giriş kapalıyken yalnız aksiyon görünür -->
                <Button Text="{x:Static strings:LoanFormStrings.Aksiyon_ErkenOdemePlanla}"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding Prepayments.OpenEntryCommand}"
                        AutomationId="{x:Static auto:RecordFormAutomationIds.BtnOpenLoanPrepayment}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding Prepayments.IsEntryOpen}" Value="True">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <!-- S4: erken ödeme girişi; önce şekil (tutarın sorulup sorulmayacağını o belirler), tarih en erken bugün (S64-15) -->
                <Border IsVisible="{Binding Prepayments.IsEntryOpen}">
                    <VerticalStackLayout Spacing="{StaticResource Space3}">
                        <VerticalStackLayout Spacing="{StaticResource Space1}">
                            <Label Text="{x:Static strings:LoanFormStrings.Etiket_OdemeSekli}"
                                   Style="{StaticResource Eyebrow}" />
                            <!-- Ham LoanPrepaymentMode; görünen ad ve geri çeviri ErkenOdemeTuruConverter'da -->
                            <Picker ItemsSource="{Binding Prepayments.Modes, Converter={StaticResource ErkenOdemeTuru}}"
                                    SelectedItem="{Binding Prepayments.EntryMode, Converter={StaticResource ErkenOdemeTuru}}"
                                    Title="{x:Static strings:LoanFormStrings.Etiket_OdemeSekli}"
                                    BackgroundColor="{DynamicResource SurfaceSunken}"
                                    TextColor="{DynamicResource TextPrimary}"
                                    TitleColor="{DynamicResource TextSecondary}"
                                    FontSize="{StaticResource TypeBody}"
                                    AutomationId="{x:Static auto:RecordFormAutomationIds.PickerPrepaymentMode}" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*, *"
                              RowDefinitions="Auto, Auto"
                              ColumnSpacing="{StaticResource Space2}"
                              RowSpacing="{StaticResource Space1}">
                            <Label Text="{x:Static strings:LoanFormStrings.Etiket_OdemeTarihi}"
                                   Style="{StaticResource Eyebrow}" />
                            <Label Grid.Column="1"
                                   Text="{x:Static strings:LoanFormStrings.Etiket_AnaparadanDusecek}"
                                   Style="{StaticResource Eyebrow}"
                                   IsVisible="{Binding Prepayments.IsPartial}" />
                            <DatePicker Grid.Row="1"
                                        Date="{Binding Prepayments.EntryDate, Converter={StaticResource TarihSecici}}"
                                        MinimumDate="{Binding Prepayments.MinimumDate, Converter={StaticResource TarihSecici}}"
                                        Format="dd.MM.yyyy"
                                        BackgroundColor="{DynamicResource SurfaceSunken}"
                                        TextColor="{DynamicResource TextPrimary}"
                                        FontSize="{StaticResource TypeBody}"
                                        AutomationId="{x:Static auto:RecordFormAutomationIds.PickerPrepaymentDate}" />
                            <Entry Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding Prepayments.AmountInput}"
                                   Placeholder="{x:Static strings:LoanFormStrings.YerTutucu_Tutar}"
                                   Keyboard="Numeric"
                                   IsVisible="{Binding Prepayments.IsPartial}"
                                   AutomationId="{x:Static auto:RecordFormAutomationIds.InputPrepaymentAmount}" />
                        </Grid>

                        <Grid ColumnDefinitions="*, *"
                              ColumnSpacing="{StaticResource Space2}">
                            <Button Text="{x:Static strings:LoanFormStrings.Aksiyon_Ekle}"
                                    Command="{Binding Prepayments.AddCommand}"
                                    AutomationId="{x:Static auto:RecordFormAutomationIds.BtnAddLoanPrepayment}" />
                            <Button Grid.Column="1"
                                    Text="{x:Static strings:LoanFormStrings.Aksiyon_Vazgec}"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding Prepayments.CancelEntryCommand}"
                                    AutomationId="{x:Static auto:RecordFormAutomationIds.BtnCancelLoanPrepayment}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- S1: kaydet krediyi ve erken ödemelerini tek işlemde yazıp listeye döner; vazgeç değişiklik varsa onay sorar -->
                <Grid ColumnDefinitions="*, *"
                      ColumnSpacing="{StaticResource Space2}">
                    <Button Text="{x:Static strings:LoanFormStrings.Aksiyon_Kaydet}"
                            Command="{Binding SaveCommand}"
                            AutomationId="{x:Static auto:RecordFormAutomationIds.BtnSaveLoan}" />
                    <Button Grid.Column="1"
                            Text="{x:Static strings:LoanFormStrings.Aksiyon_Vazgec}"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding CancelCommand}"
                            AutomationId="{x:Static auto:RecordFormAutomationIds.BtnCancelLoan}" />
                </Grid>
            </VerticalStackLayout>

            <!-- Hata: düzenlenecek kredi okunamadı -->
            <comp:StateBlock CurrentState="Error"
                             IconGlyph="{x:Static icons:Icons.Close}"
                             Message="{x:Static strings:LoanFormStrings.Hata_KrediYuklenemedi}"
                             ActionText="{x:Static strings:Strings.Aksiyon_TekrarDene}"
                             ActionCommand="{Binding RetryCommand}"
                             IsVisible="{Binding IsError}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
