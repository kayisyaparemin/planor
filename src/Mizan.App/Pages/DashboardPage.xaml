<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:comp="clr-namespace:Mizan.App.Components"
             xmlns:icons="clr-namespace:Mizan.App.Icons"
             xmlns:strings="clr-namespace:Mizan.App.Resources"
             xmlns:auto="clr-namespace:Mizan.Presentation.Automation;assembly=Mizan.Presentation"
             xmlns:models="clr-namespace:Mizan.Presentation.Models;assembly=Mizan.Presentation"
             xmlns:vm="clr-namespace:Mizan.Presentation.ViewModels;assembly=Mizan.Presentation"
             x:Class="Mizan.App.Pages.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             AutomationId="{x:Static auto:AutomationIds.PageDashboard}">

    <!-- EK-V3: Ana sayfa, "Rota + Tempo" (GS24, S72); 1. sayfada grafik yerine plan / şu an tablosu (GS34, S87) -->

    <ContentPage.Resources>
        <!-- Kalan ödeme satırı: ad, vade, tutar (S72-9) -->
        <DataTemplate x:Key="OdemeSatiri" x:DataType="models:DashboardRemainingItem">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="{StaticResource Space3}">
                <VerticalStackLayout Grid.Column="0" Spacing="{StaticResource Space1}">
                    <Label Text="{Binding Name}"
                           FontSize="{StaticResource TypeBody}"
                           TextColor="{DynamicResource TextPrimary}" />
                    <Label Text="{Binding DueDate, Converter={StaticResource Tarih}}"
                           Style="{StaticResource Caption}" />
                </VerticalStackLayout>
                <Label Grid.Column="1"
                       Text="{Binding Amount, Converter={StaticResource Para}}"
                       Style="{StaticResource Figure}"
                       VerticalTextAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- Plan / şu an tablosunda kart satırı: ad, plan, şu an; şu an planı aşarsa olumsuz renk (S87-1, 3) -->
        <DataTemplate x:Key="KartSatiri" x:DataType="models:PeriodCardComparisonRow">
            <comp:ComparisonRow LabelText="{Binding Name}"
                                PlanText="{Binding Planned, Converter={StaticResource Para}}"
                                CurrentText="{Binding Current, Converter={StaticResource Para}}">
                <comp:ComparisonRow.Triggers>
                    <DataTrigger TargetType="comp:ComparisonRow" Binding="{Binding IsAbovePlan}" Value="True">
                        <Setter Property="Semantic" Value="Negative" />
                    </DataTrigger>
                </comp:ComparisonRow.Triggers>
            </comp:ComparisonRow>
        </DataTemplate>
    </ContentPage.Resources>

    <!-- Başlık kabuk çubuğunda: dönem aralığı ve gün sayacı; dönem yoksa sayfanın adı (S5) -->
    <Shell.TitleView>
        <Grid ColumnDefinitions="*, Auto"
              ColumnSpacing="{StaticResource Space2}"
              Padding="{StaticResource TitleBarPadding}">
            <Label Grid.Column="0"
                   Text="{x:Static strings:Strings.Baslik_AnaSayfa}"
                   Style="{StaticResource SectionTitle}"
                   VerticalTextAlignment="Center"
                   IsVisible="{Binding HasActivePeriod, Converter={StaticResource Tersi}}" />
            <Label Grid.Column="0"
                   Style="{StaticResource SectionTitle}"
                   VerticalTextAlignment="Center"
                   IsVisible="{Binding HasActivePeriod}">
                <Label.Text>
                    <MultiBinding StringFormat="{x:Static strings:DashboardStrings.Bicim_DonemAraligi}">
                        <Binding Path="PeriodStart" Converter="{StaticResource Tarih}" />
                        <Binding Path="PeriodLastDay" Converter="{StaticResource Tarih}" />
                    </MultiBinding>
                </Label.Text>
            </Label>

            <!-- Sağda gün sayacı; dönem bittiyse "Bitti" -->
            <Grid Grid.Column="1"
                  IsVisible="{Binding HasActivePeriod}">
                <Label Style="{StaticResource Caption}"
                       VerticalTextAlignment="Center"
                       IsVisible="{Binding IsPeriodEnded, Converter={StaticResource Tersi}}">
                    <Label.Text>
                        <MultiBinding StringFormat="{x:Static strings:DashboardStrings.Bicim_GunSayaci}">
                            <Binding Path="ElapsedDays" />
                            <Binding Path="TotalDays" />
                        </MultiBinding>
                    </Label.Text>
                </Label>
                <Label Text="{x:Static strings:DashboardStrings.Etiket_Bitti}"
                       Style="{StaticResource Caption}"
                       VerticalTextAlignment="Center"
                       IsVisible="{Binding IsPeriodEnded}" />
            </Grid>
        </Grid>
    </Shell.TitleView>

    <ScrollView>
        <VerticalStackLayout Spacing="{StaticResource Space4}"
                             Padding="{StaticResource PagePadding}">

            <!-- Yükleniyor: kart şeklinde iskeletler -->
            <VerticalStackLayout Spacing="{StaticResource Space4}"
                                 AutomationId="{x:Static auto:AutomationIds.StateLoading}"
                                 IsVisible="{Binding IsLoading}">
                <comp:SkeletonBlock HeightRequest="{StaticResource ChartHeight}" />
                <comp:SkeletonBlock HeightRequest="{StaticResource Space6}" />
                <comp:SkeletonBlock HeightRequest="{StaticResource Space6}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="{StaticResource Space4}"
                                 IsVisible="{Binding IsContent}">

                <!-- Kaydırılan hero: her yüklemede 1. sayfa -->
                <comp:HeroPager Position="{Binding HeroPageIndex}"
                                AutomationId="{x:Static auto:AutomationIds.CardDashboardHero}">

                    <!-- 1. sayfa: dönem sonu ve plandan nerede sapıldığı (S1, S87) -->
                    <comp:HeroPage>
                        <VerticalStackLayout Spacing="{StaticResource Space4}">
                            <VerticalStackLayout Spacing="{StaticResource Space2}">
                                <Label Text="{x:Static strings:DashboardStrings.Etiket_DonemSonuTahmini}"
                                       Style="{StaticResource Eyebrow}"
                                       IsVisible="{Binding HasObservation}" />
                                <Label Text="{x:Static strings:DashboardStrings.Etiket_PlanlananDonemSonu}"
                                       Style="{StaticResource Eyebrow}"
                                       IsVisible="{Binding HasObservation, Converter={StaticResource Tersi}}" />

                                <Label Text="{Binding EndingBalance, Converter={StaticResource Para}}"
                                       Style="{StaticResource HeroFigure}"
                                       AutomationId="{x:Static auto:AutomationIds.LblProjectedEnding}" />

                                <HorizontalStackLayout Spacing="{StaticResource Space2}"
                                                       IsVisible="{Binding HasObservation}">
                                    <Label Text="{Binding EndingDeviation, Converter={StaticResource Para}, ConverterParameter=Isaretli, StringFormat={x:Static strings:DashboardStrings.Bicim_PlanaGore}}"
                                           Style="{StaticResource Caption}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsBehindPlan}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource NegativeText}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsAheadOfPlan}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource PositiveText}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="{Binding PlannedEndingBalance, Converter={StaticResource Para}, StringFormat={x:Static strings:DashboardStrings.Bicim_Plan}}"
                                           Style="{StaticResource Caption}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <!-- Plan / şu an tablosu: kartlar ve KMH faizi; grafik yerine (GS34). Satır yoksa görünmez (S87-4) -->
                            <VerticalStackLayout Spacing="{StaticResource Space2}"
                                                 IsVisible="{Binding Comparison.HasRows}">
                                <!-- Sütun başlığı ComparisonRow'la aynı oranda: başlık rakamların tam üstünde durur -->
                                <Grid ColumnDefinitions="3*, 2*, 2*" ColumnSpacing="{StaticResource Space2}">
                                    <Label Grid.Column="1"
                                           Text="{x:Static strings:DashboardStrings.Etiket_Plan}"
                                           Style="{StaticResource Eyebrow}"
                                           HorizontalTextAlignment="End" />
                                    <Label Grid.Column="2"
                                           Text="{x:Static strings:DashboardStrings.Etiket_SuAn}"
                                           Style="{StaticResource Eyebrow}"
                                           HorizontalTextAlignment="End" />
                                </Grid>

                                <VerticalStackLayout Spacing="{StaticResource Space2}"
                                                     BindableLayout.ItemsSource="{Binding Comparison.Cards}"
                                                     BindableLayout.ItemTemplate="{StaticResource KartSatiri}" />

                                <!-- KMH faizi: yalnız plan ya da şu an > 0; bakiye yoksa şu an tire (S87-2) -->
                                <comp:ComparisonRow LabelText="{x:Static strings:DashboardStrings.Etiket_KmhFaizi}"
                                                    PlanText="{Binding Comparison.PlannedDeficitInterest, Converter={StaticResource Para}}"
                                                    CurrentText="{Binding Comparison.CurrentDeficitInterest, Converter={StaticResource Para}}"
                                                    IsVisible="{Binding Comparison.HasDeficitInterest}">
                                    <comp:ComparisonRow.Triggers>
                                        <DataTrigger TargetType="comp:ComparisonRow" Binding="{Binding Comparison.IsDeficitInterestAbovePlan}" Value="True">
                                            <Setter Property="Semantic" Value="Negative" />
                                        </DataTrigger>
                                    </comp:ComparisonRow.Triggers>
                                </comp:ComparisonRow>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </comp:HeroPage>

                    <!-- 2. sayfa: yaşam giderinin temposu (S2) -->
                    <comp:HeroPage>
                        <VerticalStackLayout Spacing="{StaticResource Space3}">
                            <Grid HorizontalOptions="Center"
                                  WidthRequest="{StaticResource ChartHeight}"
                                  HeightRequest="{StaticResource ChartHeight}">
                                <GraphicsView Drawable="{Binding Gauge, Converter={StaticResource HalkaGosterge}}"
                                              InputTransparent="True" />

                                <VerticalStackLayout HorizontalOptions="Center"
                                                     VerticalOptions="Center"
                                                     Spacing="{StaticResource Space1}"
                                                     IsVisible="{Binding HasObservation}">
                                    <Label Text="{x:Static strings:DashboardStrings.Etiket_KalanYasamGideri}"
                                           Style="{StaticResource Caption}"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="{Binding RemainingVariableExpenseAllowance, Converter={StaticResource Para}}"
                                           FontSize="{StaticResource TypeTitle}"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="{DynamicResource TextPrimary}"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>

                                <Label Text="{x:Static strings:DashboardStrings.Etiket_BakiyeGirilmedi}"
                                       FontSize="{StaticResource TypeBody}"
                                       TextColor="{DynamicResource TextSecondary}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       IsVisible="{Binding HasObservation, Converter={StaticResource Tersi}}" />
                            </Grid>

                            <!-- Yaşam giderinin tutarları: planlanan her zaman, harcanan tutar ve oranıyla yalnız tempo varken (S87-6) -->
                            <comp:MetricRow LabelText="{x:Static strings:DashboardStrings.Etiket_Planlanan}"
                                            ValueText="{Binding Comparison.PlannedLivingExpense, Converter={StaticResource Para}}" />
                            <comp:MetricRow LabelText="{x:Static strings:DashboardStrings.Etiket_Harcanan}"
                                            IsVisible="{Binding HasPace}">
                                <comp:MetricRow.ValueText>
                                    <MultiBinding StringFormat="{x:Static strings:DashboardStrings.Bicim_TutarOran}">
                                        <Binding Path="Comparison.SpentLivingExpense" Converter="{StaticResource Para}" />
                                        <Binding Path="SpentRatio" Converter="{StaticResource Yuzde}" ConverterParameter="N0" />
                                    </MultiBinding>
                                </comp:MetricRow.ValueText>
                            </comp:MetricRow>
                            <comp:MetricRow LabelText="{x:Static strings:DashboardStrings.Etiket_GecenSure}"
                                            ValueText="{Binding PaceElapsedRatio, Converter={StaticResource Yuzde}, ConverterParameter=N0}"
                                            IsVisible="{Binding HasPace}" />

                            <Label Text="{Binding PaceGapPoints, Converter={StaticResource TempoCumlesi}}"
                                   Style="{StaticResource Caption}"
                                   IsVisible="{Binding HasPace}" />
                            <Label Text="{x:Static strings:DashboardStrings.Cumle_TempoIlkBakiye}"
                                   Style="{StaticResource Caption}"
                                   HorizontalTextAlignment="Center"
                                   IsVisible="{Binding HasObservation, Converter={StaticResource Tersi}}" />
                        </VerticalStackLayout>
                    </comp:HeroPage>
                </comp:HeroPager>

                <!-- Bakiye kartı: son bakiye (S3); dönem bittiyse aynı yerde kapanış (S5, S68-4) -->
                <Border BackgroundColor="{DynamicResource SurfaceCard}"
                        Stroke="{DynamicResource BorderSubtle}"
                        StrokeThickness="{StaticResource StrokeHairline}"
                        Padding="{StaticResource CardPadding}"
                        AutomationId="{x:Static auto:AutomationIds.CardBalance}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{StaticResource RadiusCard}" />
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="{StaticResource Space3}">
                        <VerticalStackLayout Grid.Column="0"
                                             Spacing="{StaticResource Space1}"
                                             VerticalOptions="Center"
                                             IsVisible="{Binding IsPeriodEnded, Converter={StaticResource Tersi}}">
                            <Label Text="{x:Static strings:DashboardStrings.Etiket_BankadakiBakiye}"
                                   Style="{StaticResource Eyebrow}" />
                            <HorizontalStackLayout Spacing="{StaticResource Space2}"
                                                   IsVisible="{Binding HasObservation}">
                                <Label Text="{Binding LastObservedBalance, Converter={StaticResource Para}}"
                                       Style="{StaticResource Figure}"
                                       VerticalTextAlignment="End" />
                                <Label Text="{Binding LastObservedOn, Converter={StaticResource Tarih}}"
                                       Style="{StaticResource Caption}"
                                       VerticalTextAlignment="End" />
                            </HorizontalStackLayout>
                            <Label Text="{x:Static strings:DashboardStrings.Etiket_HenuzGirilmedi}"
                                   FontSize="{StaticResource TypeBody}"
                                   TextColor="{DynamicResource TextSecondary}"
                                   IsVisible="{Binding HasObservation, Converter={StaticResource Tersi}}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="{x:Static strings:DashboardStrings.Aksiyon_BakiyeGir}"
                                Command="{Binding OpenBalanceEntryCommand}"
                                VerticalOptions="Center"
                                IsVisible="{Binding IsPeriodEnded, Converter={StaticResource Tersi}}"
                                AutomationId="{x:Static auto:AutomationIds.BtnBalanceEntry}" />

                        <VerticalStackLayout Grid.Column="0"
                                             Spacing="{StaticResource Space1}"
                                             VerticalOptions="Center"
                                             IsVisible="{Binding IsPeriodEnded}">
                            <Label Text="{x:Static strings:DashboardStrings.Etiket_DonemBitti}"
                                   Style="{StaticResource Eyebrow}" />
                            <Label Text="{Binding PeriodLastDay, Converter={StaticResource Tarih}}"
                                   Style="{StaticResource Figure}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="{x:Static strings:DashboardStrings.Aksiyon_DonemiKapat}"
                                Command="{Binding ClosePeriodCommand}"
                                VerticalOptions="Center"
                                IsVisible="{Binding IsPeriodEnded}"
                                AutomationId="{x:Static auto:AutomationIds.BtnClosePeriod}" />
                    </Grid>
                </Border>

                <!-- Hatırlatıcı (EK-V2): aktif kayıt yoksa görünmez (S4) -->
                <comp:ReminderCard IsVisible="{Binding Reminders.HasActiveReminder}"
                                   Title="{Binding Reminders.PaymentName}"
                                   Message="{Binding Reminders.Message}"
                                   PrimaryActionText="{x:Static strings:DashboardStrings.Aksiyon_Odedim}"
                                   PrimaryActionCommand="{Binding Reminders.MarkAsPaidCommand}"
                                   SecondaryActionText="{x:Static strings:DashboardStrings.Aksiyon_Ertele}"
                                   SecondaryActionCommand="{Binding Reminders.SnoozeCommand}" />

                <!-- Kalan ödemeler: üç satır; fazlası "+N daha" ile yerinde açılır (S4, S75-9) -->
                <comp:ListCard EyebrowText="{x:Static strings:DashboardStrings.Etiket_KalanOdemeler}"
                               ItemsSource="{Binding RemainingLines}"
                               ItemTemplate="{StaticResource OdemeSatiri}"
                               OverflowText="{Binding HiddenRemainingCount, Converter={StaticResource FazlaKayit}}"
                               OverflowCommand="{Binding ExpandRemainingCommand}"
                               AutomationId="{x:Static auto:AutomationIds.ListRemainingPayments}">
                    <comp:ListCard.NoteText>
                        <MultiBinding StringFormat="{x:Static strings:DashboardStrings.Bicim_OdemeAdediToplam}">
                            <Binding Path="RemainingCount" />
                            <Binding Path="RemainingPlannedTotal" Converter="{StaticResource Para}" />
                        </MultiBinding>
                    </comp:ListCard.NoteText>
                </comp:ListCard>
            </VerticalStackLayout>

            <!-- Boş: açık dönem yok -->
            <comp:StateBlock CurrentState="Empty"
                             IconGlyph="{x:Static icons:Icons.AccountBalance}"
                             Message="{x:Static strings:DashboardStrings.Cumle_AcikDonemYokRehber}"
                             ActionText="{x:Static strings:Strings.Aksiyon_TemizBasla}"
                             ActionCommand="{Binding OpenOnboardingCommand}"
                             IsVisible="{Binding IsEmpty}"
                             AutomationId="{x:Static auto:AutomationIds.StateEmpty}" />

            <!-- Hata: genel metin, hata hesaptan da gelebilir -->
            <comp:StateBlock CurrentState="Error"
                             IconGlyph="{x:Static icons:Icons.Close}"
                             Message="{x:Static strings:DashboardStrings.Hata_DashboardYuklenemedi}"
                             ActionText="{x:Static strings:Strings.Aksiyon_TekrarDene}"
                             ActionCommand="{Binding LoadCommand}"
                             IsVisible="{Binding IsError}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
