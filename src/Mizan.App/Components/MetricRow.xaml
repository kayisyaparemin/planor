<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mizan.App.Components.MetricRow"
             x:Name="Root">
    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="{StaticResource Space2}">
        <Label Grid.Column="0"
               Text="{Binding IconGlyph, Source={x:Reference Root}}"
               FontFamily="MaterialSymbols"
               FontSize="{StaticResource IconSmall}"
               TextColor="{DynamicResource TextSecondary}"
               VerticalTextAlignment="Center"
               IsVisible="{Binding HasIcon, Source={x:Reference Root}}" />

        <Label Grid.Column="1"
               Text="{Binding LabelText, Source={x:Reference Root}}"
               FontSize="{StaticResource TypeBody}"
               TextColor="{DynamicResource TextPrimary}"
               VerticalTextAlignment="Center" />

        <Label Grid.Column="2"
               x:Name="ValueLabel"
               Text="{Binding ValueText, Source={x:Reference Root}}"
               Style="{StaticResource Figure}"
               TextColor="{DynamicResource TextPrimary}"
               VerticalTextAlignment="Center"
               HorizontalTextAlignment="End" />
    </Grid>
</ContentView>
