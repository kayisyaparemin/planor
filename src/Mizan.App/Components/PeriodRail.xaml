<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mizan.App.Components.PeriodRail"
             x:Name="Root">
    <VerticalStackLayout Spacing="{StaticResource Space1}">
        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="{StaticResource Space2}">
            <Label Grid.Column="0"
                   Text="{Binding PeriodName, Source={x:Reference Root}}"
                   Style="{StaticResource SectionTitle}"
                   VerticalTextAlignment="Center" />

            <Label Grid.Column="1"
                   Text="{Binding DayCountText, Source={x:Reference Root}}"
                   Style="{StaticResource Caption}"
                   VerticalTextAlignment="Center"
                   HorizontalTextAlignment="End" />
        </Grid>

        <ProgressBar Progress="{Binding Progress, Source={x:Reference Root}}"
                     ProgressColor="{DynamicResource Indicator}" />
    </VerticalStackLayout>
</ContentView>
