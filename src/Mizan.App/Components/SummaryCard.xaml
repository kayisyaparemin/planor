<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mizan.App.Components.SummaryCard"
             x:Name="Root">
    <Border BackgroundColor="{DynamicResource SurfaceCard}"
            Stroke="{DynamicResource BorderSubtle}"
            StrokeThickness="{StaticResource StrokeHairline}"
            Padding="{StaticResource CardPadding}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="{StaticResource RadiusCard}" />
        </Border.StrokeShape>

        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="{StaticResource Space2}">
            <VerticalStackLayout Grid.Column="0"
                                 Spacing="{StaticResource Space1}"
                                 VerticalOptions="Center">
                <Label Text="{Binding EyebrowText, Source={x:Reference Root}}"
                       Style="{StaticResource Eyebrow}" />

                <Label Text="{Binding NoteText, Source={x:Reference Root}}"
                       Style="{StaticResource Caption}"
                       IsVisible="{Binding HasNote, Source={x:Reference Root}}" />
            </VerticalStackLayout>

            <Label Grid.Column="1"
                   x:Name="FigureLabel"
                   Text="{Binding FigureText, Source={x:Reference Root}}"
                   Style="{StaticResource HeroFigure}"
                   TextColor="{DynamicResource TextPrimary}"
                   HorizontalTextAlignment="End"
                   VerticalTextAlignment="Center" />
        </Grid>
    </Border>
</ContentView>
