<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mizan.App.Components.ComparisonRow"
             x:Name="Root">
    <!-- Kolonlar sabit oranlı: satırlar alt alta durunca plan ve şu an rakamları aynı hizada kalır (GS34-2).
         Sayfadaki sütun başlığı aynı oranı kullanır. -->
    <Grid ColumnDefinitions="3*, 2*, 2*" ColumnSpacing="{StaticResource Space2}">
        <Label Grid.Column="0"
               Text="{Binding LabelText, Source={x:Reference Root}}"
               FontSize="{StaticResource TypeBody}"
               TextColor="{DynamicResource TextPrimary}"
               VerticalTextAlignment="Center" />

        <Label Grid.Column="1"
               Text="{Binding PlanText, Source={x:Reference Root}}"
               Style="{StaticResource Figure}"
               TextColor="{DynamicResource TextSecondary}"
               HorizontalTextAlignment="End"
               VerticalTextAlignment="Center" />

        <Label Grid.Column="2"
               x:Name="CurrentLabel"
               Text="{Binding CurrentText, Source={x:Reference Root}}"
               Style="{StaticResource Figure}"
               TextColor="{DynamicResource TextPrimary}"
               HorizontalTextAlignment="End"
               VerticalTextAlignment="Center" />
    </Grid>
</ContentView>
