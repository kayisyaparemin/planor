<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mizan.App.Components.SkeletonBlock"
             x:Name="Root">
    <Border BackgroundColor="{DynamicResource SurfaceSunken}"
            Stroke="Transparent"
            StrokeThickness="{StaticResource StrokeHairline}"
            HeightRequest="{Binding HeightRequest, Source={x:Reference Root}}"
            WidthRequest="{Binding WidthRequest, Source={x:Reference Root}}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="{Binding CornerRadius, Source={x:Reference Root}}" />
        </Border.StrokeShape>
    </Border>
</ContentView>
