<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- Boşluklar (Space1 - Space6) -->
    <x:Double x:Key="Space1">4</x:Double>
    <x:Double x:Key="Space2">8</x:Double>
    <x:Double x:Key="Space3">12</x:Double>
    <x:Double x:Key="Space4">16</x:Double>
    <x:Double x:Key="Space5">24</x:Double>
    <x:Double x:Key="Space6">32</x:Double>

    <!-- Yarıçaplar -->
    <x:Double x:Key="RadiusChip">4</x:Double>
    <x:Double x:Key="RadiusCard">8</x:Double>
    <x:Double x:Key="RadiusHero">12</x:Double>
    <x:Double x:Key="RadiusPill">999</x:Double>
    <x:Int32 x:Key="RadiusButton">8</x:Int32>

    <!-- Çizgi Kalınlığı -->
    <x:Double x:Key="StrokeHairline">1</x:Double>

    <!-- Türetilmiş Dolgular -->
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="PagePadding">16,16,16,32</Thickness>
</ResourceDictionary>
